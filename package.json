{
  "name": "latin-quest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "qa:verify-retries": "node tests/local/verify-idempotency.mjs",
    "qa:verify-classroom": "node tests/local/verify-classroom.mjs",
    "qa:setup": "node tests/local/setup.mjs",
    "qa:app": "node tests/local/app.mjs",
    "qa:start": "npx --yes supabase@2.117.0 start --workdir tests/local --exclude logflare,vector,edge-runtime,supavisor",
    "qa:stop": "npx --yes supabase@2.117.0 stop --workdir tests/local",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "ai": "^7.0.85",
    "exceljs": "^4.4.0",
    "next": "^15.5.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-test-renderer": "18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "8.5.26",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.26",
    "uuid": "11.1.1"
  }
}
